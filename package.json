{
  "name": "opsu-revive",
  "productName": "续作",
  "version": "0.2.40",
  "description": "找回灵感，接着创造。Windows 本地项目工作台。",
  "author": "Spacesu",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "icons": "node scripts/export-icons.cjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0",
    "overlayscrollbars": "2.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "electron": "42.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.56.0",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "cc.opsu.revive",
    "productName": "续作",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/window-icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "OPSU-Revive-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "shortcutName": "续作",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
